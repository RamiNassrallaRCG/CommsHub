# Copy to .env.local to test Microsoft sign-in locally.
# Leave VITE_ENTRA_CLIENT_ID empty to use the demo email sign-in.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=1caa43b8-bf09-48b6-9b3c-bd5a56fec019

# Shared Team Calendar (needs Microsoft sign-in). Set ONE option:
# 1) Microsoft 365 group / Teams team calendar (Graph permission Group.ReadWrite.All)
VITE_TEAM_CALENDAR_GROUP_ID=
# 2) A mailbox calendar shared with the team with edit rights (Graph permission Calendars.ReadWrite.Shared)
VITE_TEAM_CALENDAR_OWNER=
VITE_TEAM_CALENDAR_ID=
